# ==============================================================================
# Apex Roofing Co. — Environment Configuration Example
# Copy this file to .env or configure secrets via `whop apps secrets set`
# DO NOT COMMIT REAL PRODUCTION SECRETS TO VERSION CONTROL
# ==============================================================================

# Whop Account Identification (prefix: biz_...)
# Found on your Whop Developer Dashboard (https://whop.com/dashboard/developer)
VITE_WHOP_ACCOUNT_ID=biz_xxxxxxxxxxxxxx

# Whop Plan / Variant Identifiers (prefix: plan_...)
# Created in Whop Dashboard -> Products -> Pricing Variants
VITE_WHOP_INSPECTION_PLAN_ID=plan_roof_inspection_149
VITE_WHOP_DEPOSIT_PLAN_ID=plan_project_deposit_500
VITE_WHOP_SERVICE_PLAN_ID=plan_flat_rate_repair_899

# Server-Side Whop API Secret Key
# Required for server-side Leads ingestion (POST /leads) and Invoicing (POST /invoices)
# Must NEVER be prefixed with VITE_ or exposed in browser code
WHOP_API_KEY=whop_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Whop Runtime Environment ('production' | 'sandbox')
# Default: 'production' moves real money; 'sandbox' connects to https://sandbox-api.whop.com
WHOP_ENVIRONMENT=sandbox

# Optional Custom Whop API Origin (automatically injected by Whop hosting runtime)
# WHOP_API_ORIGIN=https://api.whop.com/api/v1
